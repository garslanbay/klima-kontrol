static esp_err_t root_get_handler(httpd_req_t *req)
{
    httpd_resp_set_type(req, "text/html");
    httpd_resp_send(req, HTML_PAGE, HTTPD_RESP_USE_STRLEN);
    return ESP_OK;
}

static bool get_query_param(httpd_req_t *req, const char *key, char *out, size_t out_len)
{
    char query[128];
    if (httpd_req_get_url_query_str(req, query, sizeof(query)) != ESP_OK) return false;
    return httpd_query_key_value(query, key, out, out_len) == ESP_OK;
}

static esp_err_t cmd_get_handler(httpd_req_t *req)
{
    char val[32];

    if (get_query_param(req, "power", val, sizeof(val))) {
        g_ac_state.power = (strcmp(val, "on") == 0);
    }
    if (get_query_param(req, "tempval", val, sizeof(val))) {
        int t = atoi(val);
        if (t >= 16 && t <= 31) g_ac_state.temp = t;
    }
    if (get_query_param(req, "fan", val, sizeof(val))) {
        if (!strcmp(val, "auto")) g_ac_state.fan = TCL_FAN_AUTO;
        else if (!strcmp(val, "low"))  g_ac_state.fan = TCL_FAN_LOW;
        else if (!strcmp(val, "med"))  g_ac_state.fan = TCL_FAN_MED;
        else if (!strcmp(val, "high")) g_ac_state.fan = TCL_FAN_HIGH;
    }
    if (get_query_param(req, "swing", val, sizeof(val))) {
        if (!strcmp(val, "on"))  g_ac_state.swingv = TCL_SWINGV_ON;
        else if (!strcmp(val, "off")) g_ac_state.swingv = TCL_SWINGV_OFF;
    }

    esp_err_t err = tcl_send_current_state();

    char resp[80];
    snprintf(resp, sizeof(resp), "%s | P:%d T:%d F:%d S:%d",
             err == ESP_OK ? "OK" : "HATA",
             g_ac_state.power, g_ac_state.temp, g_ac_state.fan, g_ac_state.swingv);
    httpd_resp_set_type(req, "text/plain");
    httpd_resp_send(req, resp, HTTPD_RESP_USE_STRLEN);
    return ESP_OK;
}

static httpd_handle_t start_webserver(void)
{
    httpd_handle_t server = NULL;
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    config.lru_purge_enable = true;

    ESP_ERROR_CHECK(httpd_start(&server, &config));

    httpd_uri_t root_uri = { .uri = "/", .method = HTTP_GET, .handler = root_get_handler };
    httpd_register_uri_handler(server, &root_uri);

    httpd_uri_t cmd_uri = { .uri = "/cmd", .method = HTTP_GET, .handler = cmd_get_handler };
    httpd_register_uri_handler(server, &cmd_uri);

    return server;
}

// =================================================================
// THINGSPEAK POLLING (uzaktan kontrol)
// =================================================================
static char ts_response_buf[512];
static int ts_response_len = 0;

static esp_err_t ts_http_event_handler(esp_http_client_event_t *evt)
{
    if (evt->event_id == HTTP_EVENT_ON_DATA) {
        if (ts_response_len + evt->data_len < (int)sizeof(ts_response_buf) - 1) {
            memcpy(ts_response_buf + ts_response_len, evt->data, evt->data_len);
            ts_response_len += evt->data_len;
            ts_response_buf[ts_response_len] = '\0';
        }
    }
    return ESP_OK;
}

static void thingspeak_poll_task(void *pvParameters)
{
    char url[256];
    snprintf(url, sizeof(url),
             "https://api.thingspeak.com/channels/%s/feeds/last.json?api_key=%s",
             THINGSPEAK_CHANNEL_ID, THINGSPEAK_READ_API_KEY);

    vTaskDelay(pdMS_TO_TICKS(5000));

    while (1) {
        ts_response_len = 0;
        ts_response_buf[0] = '\0';

        esp_http_client_config_t config = {
            .url = url,
            .event_handler = ts_http_event_handler,
            .crt_bundle_attach = esp_crt_bundle_attach,
            .timeout_ms = 8000,
        };
        esp_http_client_handle_t client = esp_http_client_init(&config);
        esp_err_t err = esp_http_client_perform(client);

        if (err == ESP_OK && ts_response_len > 0) {
            cJSON *root = cJSON_Parse(ts_response_buf);
            if (root) {
                cJSON *f1 = cJSON_GetObjectItem(root, "field1");
                cJSON *f2 = cJSON_GetObjectItem(root, "field2");
                cJSON *f3 = cJSON_GetObjectItem(root, "field3");
                cJSON *f4 = cJSON_GetObjectItem(root, "field4");

                bool new_power    = g_ac_state.power;
                int  new_temp     = g_ac_state.temp;
                uint8_t new_fan   = g_ac_state.fan;
                uint8_t new_swing = g_ac_state.swingv;

                if (cJSON_IsString(f1) && f1->valuestring) new_power = (atoi(f1->valuestring) != 0);
                if (cJSON_IsString(f2) && f2->valuestring) {
                    int t = atoi(f2->valuestring);
                    if (t >= 16 && t <= 31) new_temp = t;
                }
                if (cJSON_IsString(f3) && f3->valuestring) new_fan = (uint8_t)atoi(f3->valuestring);
                if (cJSON_IsString(f4) && f4->valuestring) new_swing = (uint8_t)atoi(f4->valuestring);

                if (new_power != g_ac_state.power || new_temp != g_ac_state.temp ||
                    new_fan != g_ac_state.fan || new_swing != g_ac_state.swingv) {
                    ESP_LOGI(TAG, "ThingSpeak'ten yeni komut: P=%d T=%d F=%d S=%d",
                             new_power, new_temp, new_fan, new_swing);
                    g_ac_state.power = new_power;
                    g_ac_state.temp = new_temp;
                    g_ac_state.fan = new_fan;
                    g_ac_state.swingv = new_swing;
                    tcl_send_current_state();
                }
                cJSON_Delete(root);
            } else {
                ESP_LOGW(TAG, "ThingSpeak JSON parse hatasi: %s", ts_response_buf);
            }
        } else {
            ESP_LOGW(TAG, "ThingSpeak istegi basarisiz: %s", esp_err_to_name(err));
        }
        esp_http_client_cleanup(client);

        vTaskDelay(pdMS_TO_TICKS(THINGSPEAK_POLL_INTERVAL_MS));
    }
}

// =================================================================
// WiFi STA
// =================================================================
static void wifi_event_handler(void *arg, esp_event_base_t event_base,
                                int32_t event_id, void *event_data)
{
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
        esp_wifi_connect();
    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
        ESP_LOGW(TAG, "Baglanti koptu, tekrar deneniyor...");
        vTaskDelay(pdMS_TO_TICKS(1000));
        esp_wifi_connect();
    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
        ip_event_got_ip_t *event = (ip_event_got_ip_t *)event_data;
        ESP_LOGI(TAG, "IP alindi: " IPSTR, IP2STR(&event->ip_info.ip));
        xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
    }
}

static void wifi_init_sta(void)
{
    s_wifi_event_group = xEventGroupCreate();

    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());
    esp_netif_create_default_wifi_sta();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL));
    ESP_ERROR_CHECK(esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL));

    wifi_config_t wifi_config = {
        .sta = {
            .ssid = WIFI_STA_SSID,
            .password = WIFI_STA_PASS,
        },
    };

    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
    ESP_ERROR_CHECK(esp_wifi_start());

    ESP_LOGI(TAG, "WiFi baslatildi, '%s' agina baglaniliyor...", WIFI_STA_SSID);

    EventBits_t bits = xEventGroupWaitBits(s_wifi_event_group, WIFI_CONNECTED_BIT,
                                            pdFALSE, pdTRUE, pdMS_TO_TICKS(15000));
    if (bits & WIFI_CONNECTED_BIT) {
        ESP_LOGI(TAG, "WiFi baglantisi basarili!");
    } else {
        ESP_LOGE(TAG, "WiFi baglantisi zaman asimina ugradi! SSID/sifreyi kontrol edin.");
    }
}

static void ir_tx_init(void)
{
    rmt_tx_channel_config_t tx_channel_cfg = {
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .resolution_hz = IR_RESOLUTION_HZ,
        .mem_block_symbols = 64,
        .gpio_num = IR_TX_GPIO_NUM,
        .trans_queue_depth = 4,
        .flags.invert_out = false,
    };
    ESP_ERROR_CHECK(rmt_new_tx_channel(&tx_channel_cfg, &tx_channel));

    rmt_carrier_config_t carrier_cfg = { .frequency_hz = 38000, .duty_cycle = 0.33 };
    ESP_ERROR_CHECK(rmt_apply_carrier(tx_channel, &carrier_cfg));

    rmt_copy_encoder_config_t copy_encoder_cfg = {};
    ESP_ERROR_CHECK(rmt_new_copy_encoder(&copy_encoder_cfg, &copy_encoder));

    ESP_ERROR_CHECK(rmt_enable(tx_channel));
}

void app_main(void)
{
    ESP_LOGI(TAG, "TCL112AC WiFi+ThingSpeak Kontrolcusu baslatiliyor...");

    ESP_ERROR_CHECK(nvs_flash_init());

    wifi_init_sta();
    ir_tx_init();
    start_webserver();

    xTaskCreate(thingspeak_poll_task, "ts_poll", 8192, NULL, 5, NULL);

    ESP_LOGI(TAG, "Hazir! Yerelde web sayfasi, uzaktan ThingSpeak calisiyor.");
}
