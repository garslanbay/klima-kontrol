// =================================================================
// TX: TCL112AC
// =================================================================
static void tcl_build_state(uint8_t state[TCL_STATE_BYTES],
                             bool power, uint8_t mode, int temp_celsius,
                             uint8_t fan, uint8_t swingv, bool light)
{
    memset(state, 0, TCL_STATE_BYTES);
    state[0] = 0x23;
    state[1] = 0xCB;
    state[2] = 0x26;
    state[3] = 0x01;
    state[4] = 0x00;

    uint8_t b5 = 0;
    if (power) b5 |= (1 << 2);
    if (light) b5 |= (1 << 6);
    state[5] = b5;

    state[6] = mode & 0x0F;

    if (temp_celsius < 16) temp_celsius = 16;
    if (temp_celsius > 31) temp_celsius = 31;
    uint8_t temp_raw = (uint8_t)(31 - temp_celsius);
    state[7] = temp_raw & 0x0F;

    state[8] = (fan & 0x07) | ((swingv & 0x07) << 3);

    state[9] = 0x00;
    state[10] = 0x00;
    state[11] = 0x00;
    state[12] = 0x00;

    uint8_t sum = 0;
    for (int i = 0; i < TCL_STATE_BYTES - 1; i++) sum += state[i];
    state[13] = sum;
}

static size_t tcl_state_to_symbols(const uint8_t state[TCL_STATE_BYTES],
                                    rmt_symbol_word_t *symbols, size_t max_symbols)
{
    size_t idx = 0;
    if (max_symbols < 1 + TCL_TOTAL_BITS + 1) {
        ESP_LOGE(TAG, "Sembol buffer'i cok kucuk!");
        return 0;
    }

    symbols[idx].level0 = 1;
    symbols[idx].duration0 = TCL_HDR_MARK;
    symbols[idx].level1 = 0;
    symbols[idx].duration1 = TCL_HDR_SPACE;
    idx++;

    for (int b = 0; b < TCL_STATE_BYTES; b++) {
        for (int k = 0; k < 8; k++) {
            uint8_t bit = (state[b] >> k) & 0x1;
            symbols[idx].level0 = 1;
            symbols[idx].duration0 = TCL_BIT_MARK;
            symbols[idx].level1 = 0;
            symbols[idx].duration1 = bit ? TCL_ONE_SPACE : TCL_ZERO_SPACE;
            idx++;
        }
    }

    symbols[idx].level0 = 1;
    symbols[idx].duration0 = TCL_BIT_MARK;
    symbols[idx].level1 = 0;
    symbols[idx].duration1 = 0;
    idx++;

    return idx;
}

static esp_err_t tcl_send_command(bool power, uint8_t mode, int temp_celsius,
                                   uint8_t fan, uint8_t swingv, bool light)
{
    uint8_t state[TCL_STATE_BYTES];
    tcl_build_state(state, power, mode, temp_celsius, fan, swingv, light);

    ESP_LOGI(TAG, "Gonderilecek paket:");
    for (int i = 0; i < TCL_STATE_BYTES; i++) printf("0x%02X ", state[i]);
    printf("\n");

    static rmt_symbol_word_t tx_symbols[120];
    size_t n = tcl_state_to_symbols(state, tx_symbols, 120);
    if (n == 0) return ESP_FAIL;

    rmt_transmit_config_t tx_config = { .loop_count = 0 };
    esp_err_t err = rmt_transmit(tx_channel, copy_encoder, tx_symbols,
                                  n * sizeof(rmt_symbol_word_t), &tx_config);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Gonderim hatasi: %s", esp_err_to_name(err));
        return err;
    }
    ESP_ERROR_CHECK(rmt_tx_wait_all_done(tx_channel, portMAX_DELAY));
    ESP_LOGI(TAG, "Komut gonderildi! (%d sembol)", (int)n);
    return ESP_OK;
}

static esp_err_t tcl_send_current_state(void)
{
    return tcl_send_command(g_ac_state.power, TCL_MODE_COOL, g_ac_state.temp,
                             g_ac_state.fan, g_ac_state.swingv, false);
}

