body{font-family:sans-serif;text-align:center;background:#111;color:#eee;padding:20px}
button{font-size:22px;padding:16px 20px;margin:6px;border-radius:10px;border:none;min-width:80px}
.on{background:#2ecc71;color:#000}
.off{background:#e74c3c;color:#fff}
.temp{background:#f1c40f;color:#000;font-size:30px}
.fan{background:#3498db;color:#fff}
.swing{background:#9b59b6;color:#fff}
#tempval{font-size:36px;margin:0 12px}
#status{margin-top:20px;font-size:16px;color:#aaa}
h3{margin-top:25px;margin-bottom:8px;color:#888;font-weight:normal}
</style>
</head>
<body>
<h2>Klima Uzaktan Kontrol</h2>
<div>
  <button class="on" onclick="sendField(1,1)">AC</button>
  <button class="off" onclick="sendField(1,0)">KAPAT</button>
</div>
<div style="margin-top:15px">
  <button class="temp" onclick="changeTemp(-1)">-</button>
  <span id="tempval">24</span>C
  <button class="temp" onclick="changeTemp(1)">+</button>
</div>
<h3>Fan Hizi</h3>
<div>
  <button class="fan" onclick="sendField(3,0)">Auto</button>
  <button class="fan" onclick="sendField(3,2)">Dusuk</button>
  <button class="fan" onclick="sendField(3,3)">Orta</button>
  <button class="fan" onclick="sendField(3,5)">Yuksek</button>
</div>
<h3>Salinim</h3>
<div>
  <button class="swing" onclick="sendField(4,7)">Salinim Ac</button>
  <button class="swing" onclick="sendField(4,0)">Salinim Kapa</button>
</div>
<div id="status">Hazir</div>

<script>
const WRITE_API_KEY = "YAZMA_API_KEYINIZ"; // <-- BURAYA THINGSPEAK WRITE API KEY YAZIN
let temp = 24;

function setStatus(msg) {
  document.getElementById('status').innerText = msg;
}

function sendField(fieldNum, value) {
  const url = `https://api.thingspeak.com/update?api_key=${WRITE_API_KEY}&field${fieldNum}=${value}`;
  setStatus('Gonderiliyor...');
  fetch(url)
    .then(r => r.text())
    .then(t => {
      if (t === "0") {
        setStatus('HATA: ThingSpeak kabul etmedi (15sn bekleyip tekrar deneyin)');
      } else {
        setStatus('Gonderildi (kayit #' + t + ')');
      }
    })
    .catch(e => setStatus('Baglanti hatasi: ' + e));
}

function changeTemp(delta) {
  temp += delta;
  if (temp < 16) temp = 16;
  if (temp > 31) temp = 31;
  document.getElementById('tempval').innerText = temp;
  sendField(2, temp);
}
</script>
</body>
</html>
